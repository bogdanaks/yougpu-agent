[Unit]
Description=S3 Storage Mount ({{.DriveID}})
After=network-online.target
Wants=network-online.target
Before=docker.service

[Service]
Type=notify
TimeoutStopSec=1800
EnvironmentFile={{.EnvFile}}
ExecStart={{.Command}}
ExecStop=/bin/fusermount -uz {{.MountPath}}
Restart=on-failure
RestartSec=10
OOMScoreAdjust=-900
User=root

[Install]
WantedBy=multi-user.target
